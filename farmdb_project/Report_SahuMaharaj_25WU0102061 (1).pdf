854 0 obj
<<
/Type /StructElem
/S /P
/P 107 0 R
/E (pPlan\(FieldID, SeasonID\); CREATE INDEX ix_app ON Application\(PlanID, InputID\); CREATE INDEX ix_sales ON Sales\(HarvestID, BuyerID\); CREATE INDEX ix_irr ON IrrigationEvent\(PlanID\); -- Procedural Trigger 1: Enforce Crop Plan Dates Fall Strictly Within Selected Season CREATE TRIGGER trg_plan_season BEFOR E INSERT ON CropPlan BEGIN SELECT RAISE\(ABORT, 'Business Rule Error: Crop dates must fall within sea son bounds'\) WHERE NOT EXISTS \( SELECT 1 FROM Season s WHERE s.SeasonID = NEW.SeasonID AND NEW.SowDa te >= s.StartDate AND NEW.HarvestDate <= s.EndDate \); END; -- Procedural Trigger 2: Enforce Input Ap plication Within Crop Duration & Verify Stock CREATE TRIGGER trg_app_dur BEFORE INSERT ON Applicatio n BEGIN SELECT RAISE\(ABORT, 'Business Rule Error: Application must fall within crop duration'\) WHERE NOT EXISTS \( SELECT 1 FROM CropPlan p WHERE p.PlanID = NEW.PlanID AND NEW.AppDate BETWEEN p.SowDate AND p.HarvestDate \); SELECT RAISE\(ABORT, 'Business Rule Error: Insufficient input warehouse inventor y'\) WHERE NEW.Qty > \(SELECT StockQty FROM Input WHERE InputID = NEW.InputID\); END; -- Procedural Tri gger 3: Automated Inventory Deduction Upon Material Issuance CREATE TRIGGER trg_app_stock AFTER INSE RT ON Application BEGIN UPDATE Input SET StockQty = StockQty - NEW.Qty WHERE InputID = NEW.InputID; END; -- Procedural Trigger 4: Enforce Wholesale Sales Do Not Exceed Available Harvest Lot Stock CREA TE TRIGGER trg_sale_stock BEFORE INSERT ON Sales BEGIN SELECT RAISE\(ABORT, 'Business Rule Error: Sal es quantity exceeds available harvest lot balance'\) WHERE NEW.QtyKg > \( \(SELECT QtyKg FROM Harvest W HERE HarvestID = NEW.HarvestID\) - IFNULL\(\(SELECT SUM\(QtyKg\) FROM Sales WHERE HarvestID = NEW.Harvest ID\), 0\) \); END;)
/Pg 21 0 R
/K [16]
>>
endobj
