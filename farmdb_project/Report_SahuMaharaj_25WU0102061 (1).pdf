/E (import sqlite3 class FarmDatabase: def __init__\(self, db_path="farm_db.sqlite"\): self.conn=sqlite3.c onnect\(db_path\) self.conn.execute\("PRAGMA foreign_keys = ON;"\) self.conn.row_factory = sqlite3.Rowdefadd_c rop_plan\(self, field_id, season_id, variety_id, sow_date, harvest_date\): """Creates a crop planwithparamet erized safety and trigger enforcement.""" cursor = self.conn.cursor\(\) try: cursor.execute\("BEGINTRANSACTIO N;"\) cursor.execute\(""" INSERT INTO CropPlan \(FieldID, SeasonID, VarietyID, SowDate, HarvestDate,Status\)VA LUES \(?, ?, ?, ?, ?, 'Planned'\); """, \(field_id, season_id, variety_id, sow_date, harvest_date\)\)self.conn.c ommit\(\) return True, "Crop plan successfully registered." except sqlite3.IntegrityError as err:self.conn.ro llback\(\) return False, f"Integrity check failed: {err}" def issue_input\(self, plan_id, input_id,app_date,q ty\):"""Records input application with trigger-based stock verification.""" cursor = self.conn.cursor\(\)try: cursor.execute\("BEGIN TRANSACTION;"\) cursor.execute\(""" INSERT INTO Application \(PlanID, InputID,AppDate,Q ty\)VALUES \(?, ?, ?, ?\); """, \(plan_id, input_id, app_date, qty\)\) self.conn.commit\(\) return True,"Inputiss uedand stock deducted." except sqlite3.IntegrityError as err: self.conn.rollback\(\) return False,f"Stockis suerejected: {err}")
/Pg 29 0 R
/K [6]
>>
