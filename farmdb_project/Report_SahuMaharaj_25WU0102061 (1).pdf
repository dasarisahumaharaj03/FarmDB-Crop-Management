/E (Location TEXT NOT NULL, OwnerName TEXT NOT NULL \); CREATE TABLE Field \( FieldID INTEGER PRIMARY KEY, FarmID IN TEGER NOT NULL REFERENCES Farm\(FarmID\) ON DELETE RESTRICT, FieldName TEXT NOT NULL, AreaAcres REAL NOT NULL CH ECK\(AreaAcres > 0\), SoilType TEXT DEFAULT 'Loam', UNIQUE\(FarmID, FieldName\) \); CREATE TABLE Season \( SeasonID INTEGER PRIMARY KEY, SeasonName TEXT NOT NULL UNIQUE, StartDate TEXT NOT NULL, EndDate TEXT NOT NULL, CHECK\(En dDate > StartDate\) \); CREATE TABLE Crop \( CropID INTEGER PRIMARY KEY, CropName TEXT NOT NULL UNIQUE, DurationD ays INTEGER NOT NULL CHECK\(DurationDays > 0\) \); CREATE TABLE Variety \( VarietyID INTEGER PRIMARY KEY, CropID I NTEGER NOT NULL REFERENCES Crop\(CropID\), VarietyName TEXT NOT NULL, UNIQUE\(CropID, VarietyName\) \); CREATE TABL E SoilTest \( TestID INTEGER PRIMARY KEY, FieldID INTEGER NOT NULL REFERENCES Field\(FieldID\), TestDate TEXT NOT NULL, pH REAL NOT NULL CHECK\(pH BETWEEN 0 AND 14\), N REAL NOT NULL CHECK\(N >= 0\), P REAL NOT NULL CHECK\(P >= 0\), K REAL NOT NULL CHECK\(K >= 0\) \); CREATE TABLE CropPlan \( PlanID INTEGER PRIMARY KEY, FieldID INTEGER NOT N ULL REFERENCES Field\(FieldID\), SeasonID INTEGER NOT NULL REFERENCES Season\(SeasonID\), VarietyID INTEGER NOT NU LL REFERENCES Variety\(VarietyID\), SowDate TEXT NOT NULL, HarvestDate TEXT NOT NULL, Status TEXT NOT NULL DEFAU LT 'Planned' CHECK\(Status IN\('Planned','Sown','Harvested'\)\), CHECK\(HarvestDate > SowDate\) \); CREATE TABLE Inpu t \( InputID INTEGER PRIMARY KEY, InputName TEXT NOT NULL UNIQUE, Type TEXT NOT NULL CHECK\(Type IN\('Fertilize r','Seed','Pesticide'\)\), Unit TEXT NOT NULL, UnitCost REAL NOT NULL CHECK\(UnitCost > 0\), StockQty REAL NOT NUL L DEFAULT 0 CHECK\(StockQty >= 0\) \); CREATE TABLE Application \( AppID INTEGER PRIMARY KEY, PlanID INTEGER NOT N ULL REFERENCES CropPlan\(PlanID\), InputID INTEGER NOT NULL REFERENCES Input\(InputID\), AppDate TEXT NOT NULL, Qt y REAL NOT NULL CHECK\(Qty > 0\) \); CREATE TABLE IrrigationEvent \( IrrID INTEGER PRIMARY KEY, PlanID INTEGER NOT NULL REFERENCES CropPlan\(PlanID\), IrrDate TEXT NOT NULL, Method TEXT NOT NULL CHECK\(Method IN\('Flood','Dri p','Sprinkler'\)\), WaterKL REAL NOT NULL CHECK\(WaterKL > 0\) \); CREATE TABLE Labour \( LabourID INTEGER PRIMARY K EY, PlanID INTEGER NOT NULL REFERENCES CropPlan\(PlanID\), WorkerName TEXT NOT NULL, Activity TEXT NOT NULL, Wor kDate TEXT NOT NULL, Hours REAL NOT NULL CHECK\(Hours > 0\), WagePerHour REAL NOT NULL CHECK\(WagePerHour > 0\) \); CREATE TABLE Harvest \( HarvestID INTEGER PRIMARY KEY, PlanID INTEGER NOT NULL REFERENCES CropPlan\(PlanID\), Har vestDate TEXT NOT NULL, QtyKg REAL NOT NULL CHECK\(QtyKg >= 0\) \); CREATE TABLE Buyer \( BuyerID INTEGER PRIMARY KEY, BuyerName TEXT NOT NULL UNIQUE, Phone TEXT \); CREATE TABLE Sales \( SalesID INTEGER PRIMARY KEY, HarvestID INTEGER NOT NULL REFERENCES Harvest\(HarvestID\), BuyerID INTEGER NOT NULL REFERENCES Buyer\(BuyerID\), SaleDate T EXT NOT NULL, QtyKg REAL NOT NULL CHECK\(QtyKg >= 0\), PricePerKg REAL NOT NULL CHECK\(PricePerKg >= 0\) \);)
